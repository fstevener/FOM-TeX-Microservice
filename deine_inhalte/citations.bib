	url = {https://link.springer.com/10.1186/s40854-026-00958-1},
	doi = {10.1186/s40854-026-00958-1},
	abstract = {Abstract
            Traditionally, the United States has been the major trading and financial partner of Latin America. However, since 2000 it has lost its hegemony in the region due to China’s growing influence. China’s emergence as a source of capital for Latin America has increasingly integrated both financial markets, potentially increasing the risk of volatility spillovers. Using a heterogeneous ARDL model, we study volatility transmission from the USA and China to six main Latin American stock markets over short-run and long-run horizons. Although the US volatility spillover has decreased over time, it is still more relevant than that of China. This finding remains after controlling for commodity price volatility. The identification of these dynamic patterns in the US and Chinese volatility spillovers can help investors to make more informed portfolio management decisions and can help policymakers in monitoring financial stability in the region.},
	language = {en},
	number = {1},
	urldate = {2026-08-15},
	journal = {Financial Innovation},
	author = {Bazán-Palomino, Walter and Winkelried, Diego},
	month = jul,
	year = {2026},
	pages = {142},
}

